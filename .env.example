# Copy to .env.local and fill in. See docs/google-sheet-setup.md
# Google Apps Script web app URL that appends signups to the waitlist sheet.
SHEET_WEBHOOK_URL=
# Shared secret. Must match the TOKEN constant inside the Apps Script.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SHEET_WEBHOOK_TOKEN=

# Admin dashboard sign-in. See docs/admin.md
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Signs the admin session cookie. Any long random string.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
