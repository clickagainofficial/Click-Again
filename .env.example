# Copy to .env.local and fill in.

# MongoDB Atlas connection string. The waitlist collection lives here.
MONGODB_URI=

# Admin dashboard sign-in. See docs/admin.md
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Signs the admin session cookie. Any long random string.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
